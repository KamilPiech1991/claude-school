---
import { Image } from 'astro:assets';
import Seg from '../Seg.astro';
import type { Course } from '../../data/site';
import { href, type Theme } from '../../data/theme';

interface Props {
  course: Course;
  theme: Theme;
}

const { course, theme } = Astro.props;
---

<section class="wrap crumbs">
  <nav aria-label="Ścieżka" class="crumbs__nav">
    <a href={`${href(theme)}#kursy`} class="crumbs__back">← Kursy</a><span>/</span><span class="crumbs__cur">{course.name}</span>
  </nav>
</section>

<section class="wrap chero">
  <div class="chero__copy">
    <div data-a="fade" class="chero__eyebrow">Kurs {course.no} · stacjonarnie lub online</div>
    <h1 class="chero__h1">
      {course.name.split(' ').map((w) => <><span class="mask" style="padding-bottom:.04em"><span data-a="word">{w}</span></span>{' '}</>)}
    </h1>
    <p data-a="fade" class="chero__lead">{course.lead}</p>
    <div data-a="fade" class="chero__dur">
      <Seg value={course.defaultHours} size="lg" labels={{ 4: '4 godziny', 8: '8 godzin' }} />
      <div class="chero__note" data-dur-note>
        {course.defaultHours === 4 ? 'Pół dnia · 4 moduły podstaw' : 'Cały dzień · 8 modułów + warsztat'}
      </div>
    </div>
  </div>

  <div class="chero__art" data-a="tiltzone">
    <div data-a="card" class="chero__photo" data-depth="0.4">
      {course.photo ? (
        <Image
          src={course.photo}
          alt={`Zajęcia kursu ${course.name}`}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 1000px) 100vw, 760px"
          format="webp"
          quality={80}
          loading="eager"
          data-a="parallax"
          class="chero__img"
        />
      ) : (
        <>
          <div data-a="parallax" class="chero__stripes"></div>
          <div class="chero__cap">zdjęcie z zajęć</div>
        </>
      )}
    </div>
    <div data-a="card" class="chero__card" data-depth="1.2">
      <div data-a="float" class="win">
        {course.id === 'zero' && (
          <>
            <div class="win__bar">Projekt · Oferty handlowe</div>
            <div class="win__body">
              <div class="win__lbl">Instrukcje projektu</div>
              <div data-a="reply" class="win__msg">Piszesz w imieniu działu sprzedaży. Ton: rzeczowy, bez superlatywów.</div>
              <div data-a="reply" class="win__msg">Zawsze kończ jednym konkretnym następnym krokiem.</div>
              <div data-a="reply" class="win__files"><span>cennik_2026.pdf</span><span>wzór_oferty.docx</span></div>
            </div>
          </>
        )}
        {course.id === 'code' && (
          <>
            <div class="win__bar">~/kalkulator-wycen</div>
            <div class="win__body win__body--code">
              <div class="win__cmd"><span class="win__acc">›</span> <span data-a="typed" data-text="Dodaj formularz wyceny i eksport do PDF">Dodaj formularz wyceny i eksport do PDF</span></div>
              <div data-a="reply" class="win__mut">● Czytam strukturę projektu…</div>
              <div data-a="reply" class="win__ok">+ src/Wycena.jsx <span class="win__mut">(84 linie)</span></div>
              <div data-a="reply" class="win__ok">+ src/eksport.js <span class="win__mut">(31 linii)</span></div>
              <div data-a="reply" class="win__acc">✓ Gotowe. Uruchom: npm run dev</div>
            </div>
          </>
        )}
        {course.id === 'cowork' && (
          <>
            <div class="win__bar">Zadanie · Zestawienie faktur z września</div>
            <div class="win__body">
              <div data-a="reply" class="win__step"><span class="win__acc">✓</span>Przeczytano 47 plików PDF z folderu Faktury</div>
              <div data-a="reply" class="win__step"><span class="win__acc">✓</span>Utworzono arkusz zestawienie_09.xlsx</div>
              <div data-a="reply" class="win__step"><span class="win__acc">✓</span>Oznaczono 3 faktury po terminie płatności</div>
              <div data-a="reply" class="win__step win__mut"><span>○</span>Czeka na Twoją akceptację</div>
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .crumbs {
    padding-top: 32px;
  }

  .crumbs__nav {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }

  .crumbs__back {
    display: inline-flex;
    align-items: center;
    color: var(--muted-2);
    height: 44px;
  }

  .crumbs__back:hover {
    color: var(--fg);
  }

  .crumbs__cur {
    color: var(--fg);
  }

  .chero {
    padding-top: 24px;
    padding-bottom: 64px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 48px;
    align-items: center;
  }

  .chero__copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .chero__eyebrow {
    font-family: var(--f-mono);
    font-size: 14px;
    color: var(--accent);
  }

  .chero__h1 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(52px, 6.6vw, 100px);
    line-height: 0.95;
    letter-spacing: var(--h1-track);
  }

  .chero__lead {
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
    color: var(--soft);
    max-width: 600px;
    text-wrap: pretty;
  }

  .chero__dur {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .chero__note {
    font-size: 15px;
    color: var(--muted-2);
  }

  .chero__art {
    position: relative;
    min-height: 440px;
  }

  .chero__photo {
    position: absolute;
    inset: 0 0 60px 60px;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--line-card);
  }

  .chero__stripes {
    position: absolute;
    inset: -40px 0;
    background: repeating-linear-gradient(135deg, var(--stripe-1) 0 10px, var(--stripe-2) 10px 20px);
  }

  .chero__img {
    position: absolute;
    inset: -40px 0;
    width: 100%;
    height: calc(100% + 80px);
    object-fit: cover;
    object-position: 55% 35%;
  }

  .chero__cap {
    position: absolute;
    right: 20px;
    top: 20px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .chero__card {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(420px, 92%);
  }

  .win {
    background: var(--terminal);
    border: 1px solid var(--line-card);
    border-radius: var(--r-sm);
    overflow: hidden;
    box-shadow: var(--shadow-term);
    font-size: 14px;
    line-height: 1.5;
  }

  .win__bar {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .win__body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .win__body--code {
    gap: 6px;
    font-family: var(--f-mono);
    font-size: 13px;
  }

  .win__lbl {
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .win__msg {
    background: var(--surface);
    border-radius: 10px;
    padding: 10px 12px;
    color: var(--soft-2);
  }

  .win__files {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .win__files span {
    border: 1px solid var(--line-2);
    border-radius: 6px;
    padding: 3px 8px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--soft);
  }

  .win__cmd {
    color: var(--fg);
    min-height: 1.5em;
  }

  .win__acc {
    color: var(--accent);
  }

  .win__mut {
    color: var(--muted);
  }

  .win__ok {
    color: var(--term-ok);
  }

  .win__step {
    display: flex;
    gap: 10px;
    color: var(--soft-2);
  }

  .win__step.win__mut {
    color: var(--muted);
  }
</style>
