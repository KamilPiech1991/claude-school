---
---

<footer class="footer">
  <div class="wrap footer__in">
    <div class="footer__brand">
      <div class="footer__name">Claude School</div>
      <div>Szkolenia z Claude · Warszawa i online</div>
    </div>
    <div class="footer__links">
      <span>kontakt@claudeschool.pl</span><span>Regulamin</span><span>Polityka prywatności</span>
    </div>
  </div>
  <div class="footer__mark" aria-hidden="true" data-a="wordmark">Claude School</div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .footer__in {
    padding-top: 48px;
    padding-bottom: 48px;
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--muted);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer__name {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 22px;
    color: var(--fg);
  }

  .footer__links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer__mark {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(48px, 13.4vw, 204px);
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-2);
    padding-bottom: 0.06em;
    user-select: none;
  }
</style>
