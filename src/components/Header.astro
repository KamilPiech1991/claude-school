---
import { href, type Theme } from '../data/theme';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
const home = href(theme);
const links = [
  ['Kursy', 'kursy'],
  ['Terminy', 'terminy'],
  ['Dla firm', 'firmy'],
  ['Trenerzy', 'trenerzy'],
];
---

<header class="header" data-header>
  <div class="wrap header__in">
    <a href={home} class="logo" aria-label="Claude School – strona główna">
      <span class="logo__mark" data-logo-mark></span>
      <span class="logo__name">Claude School</span>
    </a>
    <nav aria-label="Główna nawigacja" class="nav">
      {links.map(([label, id]) => <a href={`${home}#${id}`} class="nav__link" data-nav>{label}</a>)}
      <a href={`${home}#lekcja`} class="nav__link nav__link--accent" data-nav>Darmowa lekcja</a>
    </nav>
    <a href={`${home}#terminy`} class="cta" data-magnetic>Zapisz się</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--header-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header__in {
    padding-top: 10px;
    padding-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 12px 28px;
    flex-wrap: wrap;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    white-space: nowrap;
    min-height: 44px;
  }

  .logo__mark {
    width: 22px;
    height: 22px;
    background: var(--accent);
    border-radius: 6px;
    transform: rotate(12deg);
  }

  .logo__name {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    gap: 4px;
    flex: 1;
    flex-wrap: wrap;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    color: var(--soft);
    font-size: 15px;
    padding: 0 12px;
    height: 44px;
    white-space: nowrap;
    transition: color 0.15s;
  }

  .nav__link:hover {
    color: var(--fg);
  }

  .nav__link--accent,
  .nav__link--accent:hover {
    color: var(--accent);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    background: var(--fg);
    color: var(--bg);
    border-radius: var(--r-pill);
    padding: 0 22px;
    height: 44px;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .cta:hover {
    background: var(--accent);
    color: var(--bg);
  }

  @media (max-width: 860px) {
    .nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
      margin: 0 -12px;
    }
    .cta {
      margin-left: auto;
    }
  }
</style>
