---
---

<section id="lekcja" class="wrap section">
  <div data-a="lead" class="lead">
    <div class="lead__copy">
      <div class="lead__eyebrow">Za 0 zł</div>
      <h2 class="lead__title" data-a="split">Pierwsza lekcja Claude. Dziś wieczorem.</h2>
      <p class="lead__text">
        45 minut wideo i jedno ćwiczenie na Twoim mailu, dokumencie albo raporcie. Sprawdzisz, czy nasz sposób pracy jest dla Ciebie, zanim zapłacisz za kurs.
      </p>
      <form class="lead__form" data-lead-form novalidate>
        <label for="lead-email" class="lead__lbl">Adres e-mail</label>
        <div class="lead__row">
          <input id="lead-email" name="email" type="email" required autocomplete="email" placeholder="imie@firma.pl" class="lead__input" />
          <button type="submit" class="lead__btn" data-magnetic>Wyślij lekcję</button>
        </div>
        <div class="lead__hint" data-lead-hint>Zero spamu. Wypiszesz się jednym kliknięciem.</div>
      </form>
      <div class="lead__done" data-lead-done hidden>
        <svg class="lead__check" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="2.5" data-a="check"></circle><path d="M14 25 L21 32 L35 17" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" data-a="check"></path></svg>
        <div class="lead__done-title">Lekcja jest w drodze.</div>
        <div class="lead__done-text">Sprawdź skrzynkę <span data-lead-email></span>.</div>
      </div>
    </div>
    <div class="lead__art" data-a="tiltzone">
      <div data-a="float" class="video" data-depth="1">
        <div class="video__frame">
          <div class="video__play" data-a="playpulse">▶</div>
          <div class="video__cap">kadr z lekcji wideo</div>
        </div>
        <div class="video__bar">
          <span class="video__t video__t--on" data-a="timer">00:00</span>
          <div class="video__track"><div class="video__fill" data-a="progressfill"></div></div>
          <span class="video__t">45:00</span>
        </div>
      </div>
      <div data-a="float" class="task" data-depth="1.6">
        <div class="task__lbl">Ćwiczenie po lekcji</div>
        <div class="task__title">Przepisz jeden swój mail tak, żeby Claude napisał go w Twoim stylu.</div>
        <div class="task__tags"><span class="task__tag task__tag--on">10 min</span><span class="task__tag">Twój mail</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .lead {
    background: var(--accent);
    color: var(--bg);
    border-radius: var(--r-xl);
    padding: clamp(32px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 48px;
    align-items: center;
    overflow: hidden;
  }

  .lead__copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .lead__eyebrow {
    font-family: var(--f-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .lead__title {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .lead__text {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    max-width: 520px;
  }

  .lead__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 8px;
  }

  .lead__lbl {
    font-size: 14px;
    font-weight: 600;
  }

  .lead__row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .lead__input {
    flex: 1;
    min-width: 220px;
    background: var(--fg);
    border: 0;
    border-radius: var(--r-pill);
    padding: 0 24px;
    height: 56px;
    font-size: 17px;
    color: var(--bg);
    outline: none;
  }

  .lead__input::placeholder {
    color: var(--muted);
  }

  .lead__btn {
    background: var(--bg);
    color: var(--fg);
    border: 0;
    border-radius: var(--r-pill);
    padding: 0 28px;
    height: 56px;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .lead__hint {
    font-size: 13px;
  }

  .lead__done {
    background: var(--bg);
    color: var(--fg);
    border-radius: var(--r-sm);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .lead__check {
    width: 44px;
    height: 44px;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .lead__done-title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 26px;
  }

  .lead__done-text {
    color: var(--soft);
    font-size: 15px;
  }

  .lead__art {
    position: relative;
    min-height: 380px;
  }

  .video {
    position: absolute;
    right: 8%;
    top: 0;
    width: 72%;
    rotate: 4deg;
    background: var(--bg);
    border-radius: var(--r-sm);
    padding: 14px;
    box-shadow: var(--shadow-lead-1);
  }

  .video__frame {
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    background: repeating-linear-gradient(135deg, var(--stripe-1) 0 10px, var(--stripe-2) 10px 20px);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .video__play {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: var(--bg);
    padding-left: 4px;
  }

  .video__cap {
    position: absolute;
    left: 12px;
    top: 12px;
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .video__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 4px 4px;
    color: var(--fg);
    font-size: 14px;
  }

  .video__t {
    font-family: var(--f-mono);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .video__t--on {
    color: var(--accent);
  }

  .video__track {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: var(--line-2);
    position: relative;
  }

  .video__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 32%;
    background: var(--accent);
    border-radius: 2px;
  }

  .task {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 62%;
    rotate: -3deg;
    background: var(--fg);
    color: var(--bg);
    border-radius: var(--r-xs);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: var(--shadow-lead-2);
  }

  .task__lbl {
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--card-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .task__title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }

  .task__tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .task__tag {
    border: 1px solid var(--soft);
    border-radius: var(--r-pill);
    padding: 4px 10px;
    font-size: 12px;
  }

  .task__tag--on {
    background: var(--bg);
    color: var(--fg);
    border-color: var(--bg);
  }

  @media (max-width: 600px) {
    .video {
      width: 88%;
      right: 0;
    }
    .task {
      width: 80%;
    }
  }
</style>
