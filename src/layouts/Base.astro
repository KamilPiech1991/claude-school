---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { fontsHref, type Theme } from '../data/theme';

interface Props {
  theme: Theme;
  title: string;
  description?: string;
}

const { theme, title, description = 'Szkolenia z Claude na sali i online na żywo. Claude od zera, Claude Code i Claude Cowork w wersji 4 h lub 8 h.' } = Astro.props;
---

<!doctype html>
<html lang="pl" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <meta name="theme-color" content={theme === 'a' ? '#141210' : '#F6F5F1'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref[theme]} />
    <script is:inline>
      // Elementy animowane od zera ukrywamy dopiero, gdy wiemy, że GSAP je pokaże.
      // Zabezpieczenie: gdyby skrypt animacji się nie wczytał, po 4 s pokazujemy wszystko.
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var d = document.documentElement;
        d.classList.add('js-motion');
        setTimeout(function () {
          if (!d.classList.contains('motion-ready')) d.classList.remove('js-motion');
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"></div>
    <Header theme={theme} />
    <slot />
    <Footer />
    <script>
      import '../scripts/interactions';
      import '../scripts/animations';
    </script>
  </body>
</html>
